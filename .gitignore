# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
__pycache__/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
/test-results/
/playwright-report/

# local Solana keypairs — never commit private keys
*.keypair.json
/secrets/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Persistent local participation ledger
/.data/

# Generated Kimodo worker cache (demo clips live in public/motion-demos)
/services/kimodo/cache/

# Solana competition build artifacts (includes generated deployment keypair)
/programs/competition/target/

# Local footage used for opt-in benchmarks
/test_videos/
