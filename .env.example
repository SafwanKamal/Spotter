# Server-only credentials. Select a Gemini model with image + structured JSON support available to your account.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional smaller text-only model for joint-motion debriefs (no video or landmarks).
# Defaults to gemini-3.5-flash-lite, then GEMINI_MODEL if that is unavailable.
GEMINI_JOINT_COACH_MODEL=
# Optional text model for normalizing custom Kimodo move descriptions into structured JSON.
# Defaults to GEMINI_JOINT_COACH_MODEL, then gemini-3.5-flash-lite, then GEMINI_MODEL.
GEMINI_MOTION_MODEL=

# Server-only connection to the optional NVIDIA Kimodo worker.
KIMODO_URL=http://127.0.0.1:8001
KIMODO_API_TOKEN=
# Worker-only (set on the GPU host, not in the Next.js app):
# LOCAL_CACHE=true TEXT_ENCODER_MODE=api KIMODO_PRELOAD=1 KIMODO_CACHE_DIR=/path/to/cache
# Optional worker tuning (remote start-services.sh): KIMODO_DIFFUSION_STEPS=30

# Public devnet JSON-RPC endpoint. Never put a secret-bearing provider URL here.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Server-only prototype reward attestation. Use independent random values of at
# least 32 bytes. Required for /api/rewards/claim, attest, redeem, and the
# points leaderboard. The issuer token must never reach the browser.
REWARD_ATTESTATION_SECRET=
REWARD_ISSUER_TOKEN=

# Server-only credentials for the live-camera coaching voice.
# Text-to-speech only: short, locally generated coaching phrases are sent;
# no video or landmark data is ever sent to ElevenLabs.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Auth0 Universal Login. Domain has no scheme.
# Allowed callback: http://localhost:3000/auth/callback
# Allowed logout and web origin: http://localhost:3000
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# Server-only local demo Solana signer for Rewards when no browser wallet is present.
# Point SOLANA_KEYPAIR_PATH at a Solana CLI keypair JSON outside the repo.
# Never commit the keypair. Never set these in a public deployment.
SOLANA_DEMO_PROOF=0
SOLANA_KEYPAIR_PATH=
# Optional override for the demo signer / scripts (defaults to public devnet).
# SOLANA_RPC_URL=https://api.devnet.solana.com

# Auth0 Universal Login. Values come from the Auth0 dashboard under
# Applications > your Regular Web Application (Settings + Credentials tabs).
# In that application's Settings, the Application URIs must list
# <APP_BASE_URL>/auth/callback as an Allowed Callback URL and APP_BASE_URL
# itself as an Allowed Logout URL and Allowed Web Origin.
# Generate AUTH0_SECRET with: openssl rand -hex 32
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# Development-only escape hatch. Set to "true" to bypass the Auth0 gate so
# the app and its gated API routes work without signing in. Ignored in
# production builds (see src/lib/auth-bypass.ts). Leave unset by default.
AUTH_DISABLED=

# Persistent single-host participation ledger; requires Node >=22.13.
# REWARDS_DB_PATH=/absolute/persistent/path/rewards.sqlite
